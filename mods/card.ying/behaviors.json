{
  "rules": [
    {
      "on": "pet.drag_started",
      "when": "event.affinity % 20 == 0",
      "cooldown": 2,
      "then": [
        {
          "say": "@idle.this.lifted"
        },
        {
          "anim": "card.ying:angry"
        }
      ]
    },
    {
      "on": "pet.petted",
      "cooldown": 2,
      "when": "event.affinity % 20 != 0",
      "then": [
        {
          "say": "@idle.this.petted"
        },
        {
          "emote": "mischief"
        }
      ]
    },
    {
      "on": "timer.idle",
      "when": "rand < 0.5",
      "then": [
        {
          "say": "@idle.this.default"
        }
      ]
    },
    {
      "on": "chat.reply",
      "when": "event.ok and event.emotion != 'default'",
      "then": [
        {
          "emote": "{event.emotion}",
          "after_ms": 1500
        }
      ]
    },
    {
      "on": "feature.hello.clicked",
      "then": [
        {
          "emote": "idea",
          "after_ms": 2200
        }
      ]
    }
  ]
}